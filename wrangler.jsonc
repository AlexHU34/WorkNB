{
  // Настройка выкладки на Cloudflare.
  //
  // Смысл простой: сайт — это папка site/ с семью готовыми файлами.
  // Ничего собирать на сервере не нужно, поэтому поля «build command»
  // остаются пустыми, а Wrangler просто заливает содержимое папки.
  //
  // Почему Workers, а не старый Pages. В 2026 году Cloudflare пишет
  // прямо в документации: «Start new projects with Workers». Старый
  // Pages спрятан внизу под надписью «legacy» и при выкладке на новом
  // аккаунте падал уже после успешной загрузки файлов:
  // «Failed to publish your Function — Unknown internal error».
  // Файлы публиковались успешно, ошибка была уже на последнем шаге.

  "$schema": "node_modules/wrangler/config-schema.json",

  // Имя проекта. Из него Cloudflare делает адрес: nebulabloom.pages.dev
  "name": "nebulabloom",

  // Обязательное поле Wrangler: на какую дату считать поведение
  // платформы. Ставим сегодняшнюю, новые возможности не включаем задним
  // числом — иначе сайт может вести себя иначе, чем мы рассчитывали.
  "compatibility_date": "2026-08-01",

  // Папка, которая едет в интернет. Именно site/, а не корень: так
  // наружу не попадут tools/, src/ и docs/ — служебные скрипты проверок.
  "assets": {
    "directory": "./site",

    // Неправильный адрес показывает нашу страницу «Страница потерялась»,
    // а не серую надпись Cloudflare. Без этой строки на любом
    // несуществующем пути отдавался бы каталог игр, и поисковики видели
    // бы бесконечное число одинаковых страниц.
    "not_found_handling": "404-page"
  }
}