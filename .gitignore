# Сборка: dist/ — артефакт, воспроизводится npm run build.
dist/

# Готовый к выкладке пакет. Тоже артефакт: собирается из dist/
# скриптом tools/pack.py. В историю ему не место.
release/
release.zip

# Запасные копии. Их 39 каталогов, каждый — снимок перед правкой.
# В историю они не должны попасть никогда: смысл git в том, чтобы
# состояние хранилось в коммитах, а не в молчаливых копиях рядом.
_backup/
tools/_backup/

# Эталонные скриншоты для ручного сравнения (182 PNG).
# Попадают в историю большими бинарниками и меняются от каждого
# визуального шага. Хранятся локально.
_shots/
_shots_v2/
_shots_v3/
_shots_new/
_lang_shots/

# node_modules и всё, что генерирует сборка.
node_modules/
*.tsbuildinfo

# Временные страницы, которые оставляют гейты и отладочные пробы.
_tmp_*.html

# Системный мусор.
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
*.pyc
# Резервные копии перед переездом и перед соединением Studio с
# редактором. Это страховочка на точные состояния файлов, а не часть
# проекта: держать их в истории незачем, они лежат на диске.
_backup-before-move/
_backup-before-connect/

# ��ʵ��� ������ ��ʳ�� ��ʳ�� �� ����. ��
*.txt
!docs/*.txt

# ��ˢ��� ��� ����.
full.txt
g.txt

# Журналы прогонщиков гейтов: меняются при каждой проверке, в истории не нужны.
gate_*.log
